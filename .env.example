# Copy to .env (gitignored). The environment wins over this file.

# Which config files to read, `:`-separated and relative to this folder, instead of
# projects.yaml and its `include:` list. SDLC_PROJECT and REPOS_ROOT are read from the
# environment only.
# SDLC_CONFIG=projects.yaml:contexts/other.yaml

# Linear projects only: https://linear.app/settings/api
# GitHub Issues projects need only `gh auth login`.
LINEAR_API_KEY=
